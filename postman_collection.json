        },
        {
          "name": "PATCH Update Task by ID",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\",\n  \"progressPercent\": 50,\n  \"remarks\": \"Working on deliverable through Postman\"\n}"
            },
            "url": {
