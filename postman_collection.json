{
  "info": {
    "name": "UrbanGaon AI Todo Platform API",
    "_postman_id": "urbangaon-todo-api-v2-collection",
    "description": "Complete Postman Collection for all backend APIs in UrbanGaon AI Todo Platform.\nIncludes Authentication, Tasks, Members, Audit Logs, System Config, AI Extraction, Notifications, and Cron engines.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testTaskId",
      "value": "task-1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Session",
      "item": [
        {
          "name": "POST Login (Sign In)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ceo@urbangaon.com\",\n  \"password\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates employee / Founder. Returns JWT token in response and sets 'urbangaon_auth_token' cookie."
          }
        },
        {
          "name": "GET Current User (/api/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Validates current session token and returns logged-in user profile."
          }
        },
        {
          "name": "POST Logout (/api/auth/me)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Clears session auth cookie."
          }
        },
        {
          "name": "POST Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ceo@urbangaon.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password"
              ]
            }
          }
        }
      ]
    },
