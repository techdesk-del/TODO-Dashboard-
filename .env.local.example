# UrbanGaon AI Todo Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── MongoDB Atlas (Free Tier / M0) ─────────────────
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/urbangaon_todo?retryWrites=true&w=majority

# ── Google Gemini AI (Free API Key from Google AI Studio) ────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# ── Free Email SMTP (Gmail App Password / Ethereal / Brevo) ───
# If left empty, the system automatically uses Ethereal test inbox or in-app preview
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
# Create App Password: https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_character_gmail_app_password
SMTP_FROM="UrbanGaon Executive Dispatcher" <alerts@urbangaon.com>

# ── JWT Authentication Secret (Free In-House Auth) ────────────
JWT_SECRET=super_secret_urbangaon_jwt_signing_key_2026_xyz
