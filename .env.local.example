# UrbanGaon AI Todo Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── MongoDB Atlas ─────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/urbangaon_todo?retryWrites=true&w=majority

# ── Local MongoDB (alternative to Atlas) ────────────────────────────
# MONGODB_URI=mongodb://localhost:27017/urbangaon_todo

# ── Optional: Database name override ────────────────────────────────
MONGODB_DB_NAME=urbangaon_todo

# ── App Secrets ──────────────────────────────────────────────────────
# Used for signing API responses and webhook validation
NEXT_PUBLIC_APP_ENV=development

