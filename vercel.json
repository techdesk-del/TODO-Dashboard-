{
  "crons": [
    {
      "path": "/api/cron?action=overdue",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron?action=digest",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron?action=rollover",
      "schedule": "35 18 * * *"
    },
    {
      "path": "/api/cron?action=retention",
      "schedule": "30 20 * * *"
    }
  ]
}
