# .dockerignore — Files to EXCLUDE from Docker build context
# Keep Docker build fast by ignoring unnecessary files

# Dependencies (will be installed fresh in container)
node_modules
npm-debug.log*

# Next.js build output (rebuilt inside Docker)
.next
out
build

# Environment files (NEVER include secrets in Docker image)
.env
.env.local
.env*.local
.env.production

# Version control
.git
.gitignore

# Development files
*.md
.DS_Store
.vscode
*.log

# Test files
coverage
__tests__

# Editor configs
.editorconfig
.eslintcache
