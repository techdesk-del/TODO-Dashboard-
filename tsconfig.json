{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/frontend/*": [
        "./frontend/*"
      ],
      "@/backend/*": [
        "./backend/*"
      ],
      "@/shared/*": [
        "./shared/*"
      ],
      "@/components/*": [
        "./frontend/components/*"
      ],
      "@/context/*": [
        "./frontend/context/*"
      ],
      "@/hooks/*": [
        "./frontend/hooks/*"
      ],
      "@/styles/*": [
        "./frontend/styles/*"
      ],
      "@/models/*": [
        "./backend/models/*"
      ],
      "@/lib/*": [
        "./backend/lib/*"
      ],
      "@/types": [
        "./shared/types"
      ],
      "@/types/*": [
        "./shared/types/*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "tests",
    "scripts"
  ]
}
