# ============================================================
# UrbanGaon AI Todo Platform — Synology DS925+ Environment
# File location on NAS: /docker/urbangaon-todo/.env
# ============================================================

# ── 1. NAS Networking & Ports ───────────────────────────────
# The local port on your DS925+ NAS where the app will be accessed
# Default: 3000 (Access at http://<SYNOLOGY-NAS-IP>:3000)
APP_PORT=3000

# Base URL for the dashboard (IP or Synology QuickConnect / Custom Domain)
# Example: http://192.168.1.150:3000 or https://todo.urbangaon.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 2. Local NAS MongoDB Security ───────────────────────────
# MongoDB username & password for the private container
MONGO_INITDB_ROOT_USERNAME=urbangaon_admin
MONGO_PASSWORD=urbangaon_secure_pass_ds925_2026
MONGO_INITDB_DATABASE=urbangaon_todo

# Optional external port for MongoDB Compass (default: 27017)
MONGO_PORT=27017

# ── 3. Security & Authentication ────────────────────────────
# Secure random string for signing enterprise JWT tokens
JWT_SECRET=super_secret_urbangaon_synology_nas_jwt_key_2026_xyz987

# ── 4. Google Gemini AI (Task Autopilot) ────────────────────
# Free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── 5. Email Notifications & SMTP (Optional) ────────────────
# Configure your SMTP server for morning digests and overdue reminders
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_company_email@gmail.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM="UrbanGaon Executive Dispatcher" <alerts@urbangaon.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="UrbanGaon Executive Dispatcher" <alerts@urbangaon.com>
