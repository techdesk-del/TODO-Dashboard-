# ============================================================
# UrbanGaon AI Todo Platform — Synology DS925+ Environment
# File location on NAS: /docker/urbangaon-todo/.env
# ============================================================

# ── 1. NAS Networking & Ports ───────────────────────────────
# The local port on your DS925+ NAS where the app will be accessed
# Default: 3050 (Access at http://<SYNOLOGY-NAS-IP>:3050)
APP_PORT=3050

# Base URL for the dashboard (IP or Synology QuickConnect / Custom Domain)
# Example: http://192.168.1.246:3050 or https://todo.urbangaon.com
NEXT_PUBLIC_APP_URL=http://localhost:3050

# ── 2. MongoDB Real-Time Connection ─────────────────────────
# Live MongoDB Atlas Cloud Database (Real-time sync across all devices)
MONGODB_URI=mongodb+srv://techdesk_db_user:aakash@cluster0.vgpa6s7.mongodb.net/urbangaon_todo?retryWrites=true&w=majority&appName=Cluster0
MONGO_PASSWORD=urbangaon_secure_2026
MONGO_INITDB_ROOT_USERNAME=urbangaon_admin
MONGO_INITDB_DATABASE=urbangaon_todo

# Optional external port for local MongoDB Compass (default: 27017)
MONGO_PORT=27017

# ── 3. Security & Authentication ────────────────────────────
# Secure random string for signing enterprise JWT tokens
JWT_SECRET=urbangaon_executive_jwt_super_key_2026_9e7f8d6c5b4a3a2b1c0d

# ── 4. Google Gemini AI (Task Autopilot) ────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── 5. Email Notifications & SMTP (Real-Time Live Gmail) ────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=techdesk@urbangaon.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM="UrbanGaon Executive Dispatcher" <techdesk@urbangaon.com>
